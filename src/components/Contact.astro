---
---

<section id="contact" class="py-20 md:py-28 bg-gradient-clinical">
  <div class="mx-auto max-w-6xl px-5 sm:px-8 grid md:grid-cols-12 gap-10">
    <div class="md:col-span-5">
      <p class="text-xs uppercase tracking-[0.18em] text-clinic font-semibold mb-4">Get in touch</p>
      <h2 class="font-display text-3xl md:text-4xl text-deep-sea leading-tight">
        Book in, ask a question,<br />
        or just say hello.
      </h2>
      <p class="mt-5 text-graphite leading-relaxed">
        New patient or returning, routine or urgent — we'd love to hear from
        you. Phone us during opening hours or drop us a note any time.
      </p>

      <dl class="mt-8 space-y-5 text-[15px]">
        <div class="flex items-start gap-3">
          <span class="mt-0.5 w-9 h-9 rounded-lg bg-mint/50 text-clinic flex items-center justify-center shrink-0">
            <svg class="w-5 h-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <path d="M22 16.92v3a2 2 0 01-2.18 2 19.86 19.86 0 01-8.63-3.07 19.5 19.5 0 01-6-6 19.86 19.86 0 01-3.07-8.67A2 2 0 014.11 2h3a2 2 0 012 1.72c.13.96.36 1.9.7 2.81a2 2 0 01-.45 2.11L8.09 9.91a16 16 0 006 6l1.27-1.27a2 2 0 012.11-.45c.91.34 1.85.57 2.81.7A2 2 0 0122 16.92z" />
            </svg>
          </span>
          <div>
            <dt class="text-graphite/80 text-xs uppercase tracking-wider">Phone</dt>
            <dd class="text-deep-sea font-display text-xl">
              <a href="tel:+440000000000" class="hover:text-clinic">0000 000 0000</a>
            </dd>
          </div>
        </div>

        <div class="flex items-start gap-3">
          <span class="mt-0.5 w-9 h-9 rounded-lg bg-mint/50 text-clinic flex items-center justify-center shrink-0">
            <svg class="w-5 h-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z" />
              <polyline points="22,6 12,13 2,6" />
            </svg>
          </span>
          <div>
            <dt class="text-graphite/80 text-xs uppercase tracking-wider">Email</dt>
            <dd class="text-deep-sea font-display text-xl">
              <a href="mailto:hello@afzal.dental" class="hover:text-clinic">hello@afzal.dental</a>
            </dd>
          </div>
        </div>

        <div class="flex items-start gap-3">
          <span class="mt-0.5 w-9 h-9 rounded-lg bg-mint/50 text-clinic flex items-center justify-center shrink-0">
            <svg class="w-5 h-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 1118 0z" />
              <circle cx="12" cy="10" r="3" />
            </svg>
          </span>
          <div>
            <dt class="text-graphite/80 text-xs uppercase tracking-wider">Address</dt>
            <dd class="text-deep-sea font-display text-xl leading-tight">
              Your clinic address<br />
              <span class="text-graphite text-base font-sans">Postcode · United Kingdom</span>
            </dd>
          </div>
        </div>
      </dl>
    </div>

    <div class="md:col-span-7">
      <form
        name="afzal-dental-contact"
        method="POST"
        data-netlify="true"
        netlify-honeypot="bot-field"
        class="bg-paper rounded-2xl p-7 sm:p-9 shadow-card border border-deep-sea/5"
      >
        <input type="hidden" name="form-name" value="afzal-dental-contact" />
        <p class="hidden">
          <label>Don't fill this out: <input name="bot-field" /></label>
        </p>

        <h3 class="font-display text-2xl text-deep-sea">Send us a message</h3>
        <p class="text-graphite mt-1 text-sm">We aim to reply the same working day.</p>

        <div class="mt-6 grid sm:grid-cols-2 gap-4">
          <label class="block">
            <span class="text-sm font-medium text-deep-sea">Your name</span>
            <input
              type="text"
              name="name"
              required
              autocomplete="name"
              class="mt-1.5 w-full rounded-lg border border-deep-sea/15 bg-mist px-4 py-2.5 text-ink focus:bg-paper focus:border-clinic focus:outline-none"
            />
          </label>
          <label class="block">
            <span class="text-sm font-medium text-deep-sea">Phone</span>
            <input
              type="tel"
              name="phone"
              autocomplete="tel"
              class="mt-1.5 w-full rounded-lg border border-deep-sea/15 bg-mist px-4 py-2.5 text-ink focus:bg-paper focus:border-clinic focus:outline-none"
            />
          </label>
        </div>

        <label class="mt-4 block">
          <span class="text-sm font-medium text-deep-sea">Email</span>
          <input
            type="email"
            name="email"
            required
            autocomplete="email"
            class="mt-1.5 w-full rounded-lg border border-deep-sea/15 bg-mist px-4 py-2.5 text-ink focus:bg-paper focus:border-clinic focus:outline-none"
          />
        </label>

        <label class="mt-4 block">
          <span class="text-sm font-medium text-deep-sea">How can we help?</span>
          <textarea
            name="message"
            rows="4"
            required
            class="mt-1.5 w-full rounded-lg border border-deep-sea/15 bg-mist px-4 py-2.5 text-ink focus:bg-paper focus:border-clinic focus:outline-none"
          ></textarea>
        </label>

        <fieldset class="mt-4">
          <legend class="text-sm font-medium text-deep-sea">Preferred time</legend>
          <div class="mt-2 flex flex-wrap gap-2 text-sm">
            {["Morning", "Afternoon", "Evening", "Saturday"].map((slot) => (
              <label class="inline-flex items-center gap-2 bg-mist border border-deep-sea/15 rounded-full px-3 py-1.5 cursor-pointer hover:bg-paper">
                <input type="checkbox" name="preferredTime" value={slot} class="accent-clinic" />
                <span>{slot}</span>
              </label>
            ))}
          </div>
        </fieldset>

        <button
          type="submit"
          class="mt-7 inline-flex items-center gap-2 bg-deep-sea text-paper font-medium px-6 py-3 rounded-full hover:bg-clinic transition-colors shadow-card"
        >
          Send message
          <svg viewBox="0 0 20 20" class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
            <path d="M5 10h10M11 6l4 4-4 4" stroke-linecap="round" stroke-linejoin="round" />
          </svg>
        </button>
      </form>
    </div>
  </div>
</section>
