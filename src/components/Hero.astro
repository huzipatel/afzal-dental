---
---

<section class="bg-gradient-clinical">
  <div class="mx-auto max-w-6xl px-5 sm:px-8 pt-16 pb-20 md:pt-24 md:pb-28 grid md:grid-cols-12 gap-10 items-center">
    <div class="md:col-span-7">
      <span class="inline-flex items-center gap-2 text-xs uppercase tracking-[0.18em] text-clinic font-semibold mb-5">
        <span class="w-6 h-px bg-clinic"></span>
        Modern dentistry · Open evenings
      </span>
      <h1 class="font-display text-4xl sm:text-5xl md:text-6xl leading-[1.05] text-deep-sea">
        Dentistry that fits<br />
        <span class="italic text-clinic">around your life.</span>
      </h1>
      <p class="mt-6 text-lg text-graphite max-w-xl leading-relaxed">
        Trusted family, cosmetic and emergency dental care — delivered with calm,
        meticulous craftsmanship. Appointments available into the evening, so
        your smile doesn't have to wait for a day off work.
      </p>
      <div class="mt-8 flex flex-wrap items-center gap-4">
        <a
          href="#contact"
          class="inline-flex items-center gap-2 bg-deep-sea text-paper font-medium px-6 py-3 rounded-full hover:bg-clinic transition-colors shadow-card"
        >
          Book your appointment
          <svg viewBox="0 0 20 20" class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
            <path d="M5 10h10M11 6l4 4-4 4" stroke-linecap="round" stroke-linejoin="round" />
          </svg>
        </a>
        <a
          href="#services"
          class="inline-flex items-center gap-2 text-deep-sea font-medium px-5 py-3 rounded-full border border-deep-sea/15 hover:bg-paper transition-colors"
        >
          Explore services
        </a>
      </div>

      <dl class="mt-12 grid grid-cols-3 gap-6 max-w-md text-sm">
        <div>
          <dt class="text-graphite/80">Open until</dt>
          <dd class="font-display text-2xl text-deep-sea mt-1">8 pm</dd>
        </div>
        <div>
          <dt class="text-graphite/80">Same-week appts</dt>
          <dd class="font-display text-2xl text-deep-sea mt-1">Yes</dd>
        </div>
        <div>
          <dt class="text-graphite/80">CQC registered</dt>
          <dd class="font-display text-2xl text-deep-sea mt-1">✓</dd>
        </div>
      </dl>
    </div>

    <div class="md:col-span-5 relative">
      <!-- SVG illustration: gentle clinical motif, performant, on-brand. -->
      <div class="relative aspect-[4/5] rounded-[24px] overflow-hidden shadow-lift bg-paper">
        <div class="absolute inset-0 bg-gradient-to-br from-turquoise/15 via-mint/20 to-transparent"></div>
        <svg viewBox="0 0 400 500" class="absolute inset-0 w-full h-full" preserveAspectRatio="xMidYMid slice" aria-hidden="true">
          <defs>
            <linearGradient id="g1" x1="0" y1="0" x2="0" y2="1">
              <stop offset="0%" stop-color="#14b8a6" stop-opacity="0.30" />
              <stop offset="100%" stop-color="#0d8b8b" stop-opacity="0.05" />
            </linearGradient>
            <linearGradient id="g2" x1="0" y1="0" x2="1" y2="1">
              <stop offset="0%" stop-color="#a7f3d0" stop-opacity="0.55" />
              <stop offset="100%" stop-color="#14b8a6" stop-opacity="0.15" />
            </linearGradient>
          </defs>
          <circle cx="320" cy="100" r="110" fill="url(#g1)" />
          <circle cx="80" cy="380" r="140" fill="url(#g2)" />
          <!-- stylised tooth -->
          <g transform="translate(150 150)">
            <path
              d="M50 0 C25 0 5 15 5 40 c0 18 9 30 9 55 0 40 -20 60 -20 95 0 25 15 40 30 40 18 0 20 -20 35 -20 s17 20 35 20 c15 0 30 -15 30 -40 0 -35 -20 -55 -20 -95 0 -25 9 -37 9 -55 0 -25 -20 -40 -45 -40 z"
              fill="#ffffff"
              stroke="#0c4a4a"
              stroke-width="1.5"
              stroke-opacity="0.18"
            />
          </g>
          <!-- subtle sparkle accents -->
          <g fill="#0c4a4a" opacity="0.25">
            <circle cx="60" cy="120" r="2" />
            <circle cx="340" cy="260" r="2.5" />
            <circle cx="290" cy="430" r="2" />
          </g>
        </svg>

        <div class="absolute bottom-5 left-5 right-5 bg-paper/95 backdrop-blur rounded-xl p-4 shadow-card">
          <p class="text-xs uppercase tracking-wider text-clinic font-semibold">Tonight's availability</p>
          <p class="mt-1 text-deep-sea font-display text-lg">Same-day evening slots open</p>
          <p class="text-sm text-graphite mt-0.5">Call or message — we'll fit you in.</p>
        </div>
      </div>
    </div>
  </div>
</section>
