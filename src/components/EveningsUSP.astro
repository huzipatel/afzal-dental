---
---

<section id="evenings" class="py-20 md:py-24 bg-deep-sea text-paper relative overflow-hidden">
  <!-- Decorative gradient -->
  <div class="absolute inset-0 opacity-30 pointer-events-none" aria-hidden="true">
    <div class="absolute -top-32 -right-32 w-96 h-96 rounded-full bg-turquoise blur-3xl"></div>
    <div class="absolute -bottom-32 -left-32 w-96 h-96 rounded-full bg-clinic blur-3xl"></div>
  </div>

  <div class="relative mx-auto max-w-6xl px-5 sm:px-8 grid md:grid-cols-12 gap-10 items-center">
    <div class="md:col-span-7">
      <p class="text-xs uppercase tracking-[0.18em] text-mint font-semibold mb-4">Our promise</p>
      <h2 class="font-display text-3xl md:text-5xl leading-tight">
        Open <span class="italic text-mint">evenings</span> —<br />
        because life doesn't stop at 5 pm.
      </h2>
      <p class="mt-6 text-paper/85 text-lg leading-relaxed max-w-2xl">
        Most of our patients work full days. Bringing them in for "9 to 5 only"
        dentistry means time off, lost income, juggled childcare — and often, a
        small problem turning into a bigger one because the appointment never
        gets made.
      </p>
      <p class="mt-4 text-paper/85 text-lg leading-relaxed max-w-2xl">
        So we don't do that. We're here in the evenings, four nights a week,
        with the same unhurried care as a morning slot. Phone after work, see
        us after work, get home before bedtime.
      </p>
    </div>

    <div class="md:col-span-5">
      <div class="bg-paper text-ink rounded-2xl p-7 shadow-lift">
        <p class="text-xs uppercase tracking-[0.18em] text-clinic font-semibold">Latest evening slot</p>
        <p class="font-display text-5xl text-deep-sea mt-2">8:00 pm</p>
        <p class="text-graphite mt-1">Mon · Tue · Wed · Thu</p>

        <hr class="border-deep-sea/10 my-5" />

        <ul class="space-y-3 text-[15px]">
          <li class="flex items-start gap-3">
            <svg class="w-5 h-5 text-clinic shrink-0 mt-0.5" viewBox="0 0 20 20" fill="currentColor" aria-hidden="true">
              <path fill-rule="evenodd" d="M16.7 5.3a1 1 0 010 1.4l-8 8a1 1 0 01-1.4 0l-4-4a1 1 0 011.4-1.4L8 12.6l7.3-7.3a1 1 0 011.4 0z" clip-rule="evenodd" />
            </svg>
            <span><strong>Same-week</strong> evening appointments for routine care</span>
          </li>
          <li class="flex items-start gap-3">
            <svg class="w-5 h-5 text-clinic shrink-0 mt-0.5" viewBox="0 0 20 20" fill="currentColor" aria-hidden="true">
              <path fill-rule="evenodd" d="M16.7 5.3a1 1 0 010 1.4l-8 8a1 1 0 01-1.4 0l-4-4a1 1 0 011.4-1.4L8 12.6l7.3-7.3a1 1 0 011.4 0z" clip-rule="evenodd" />
            </svg>
            <span><strong>Same-day</strong> for emergencies — call before 6 pm</span>
          </li>
          <li class="flex items-start gap-3">
            <svg class="w-5 h-5 text-clinic shrink-0 mt-0.5" viewBox="0 0 20 20" fill="currentColor" aria-hidden="true">
              <path fill-rule="evenodd" d="M16.7 5.3a1 1 0 010 1.4l-8 8a1 1 0 01-1.4 0l-4-4a1 1 0 011.4-1.4L8 12.6l7.3-7.3a1 1 0 011.4 0z" clip-rule="evenodd" />
            </svg>
            <span>Saturday clinics for non-working hours</span>
          </li>
        </ul>

        <a
          href="#contact"
          class="mt-6 inline-flex w-full justify-center items-center gap-2 bg-deep-sea text-paper font-medium px-5 py-3 rounded-full hover:bg-clinic transition-colors"
        >
          Reserve an evening slot
          <svg viewBox="0 0 20 20" class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
            <path d="M5 10h10M11 6l4 4-4 4" stroke-linecap="round" stroke-linejoin="round" />
          </svg>
        </a>
      </div>
    </div>
  </div>
</section>
