---
import Base from "../layouts/Base.astro";
---

<Base title="Page not found — Afzal Dental" description="The page you were looking for couldn't be found.">
  <main class="min-h-screen flex items-center justify-center bg-gradient-clinical px-6 py-20">
    <div class="text-center max-w-md">
      <p class="text-xs uppercase tracking-[0.18em] text-clinic font-semibold mb-4">404</p>
      <h1 class="font-display text-4xl text-deep-sea">We can't find that page.</h1>
      <p class="mt-4 text-graphite">
        The link might be broken, or the page has moved. Let's get you back to
        somewhere useful.
      </p>
      <a
        href="/"
        class="mt-7 inline-flex items-center gap-2 bg-deep-sea text-paper font-medium px-6 py-3 rounded-full hover:bg-clinic transition-colors"
      >
        Return home
      </a>
    </div>
  </main>
</Base>
